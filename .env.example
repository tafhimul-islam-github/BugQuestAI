# ==============================================================================
# BugQuest AI — Global Environment Configuration Example
# ==============================================================================

# General
APP_NAME="BugQuest AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8001

# Database Configuration (Defaults to MySQL locally, PostgreSQL for production/docker)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bugquest_ai
DB_USERNAME=root
DB_PASSWORD=

# Cache & Session
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# AI Coaching Service (Google AI Studio / FastAPI)
AI_SERVICE_PORT=8001
AI_PROVIDER=gemini # options: gemini, openai, fallback_simulated
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=

# Code Execution Judge Configuration
# Options: isolated_sandbox (local typed adapter), judge0, piston
JUDGE_PROVIDER=isolated_sandbox
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
PISTON_API_URL=https://emkc.org/api/v2/piston

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AI_SERVICE_URL=http://localhost:8001
VITE_APP_NAME="BugQuest AI"
